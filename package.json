{
  "name": "dvs",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized Voting System - on-chain ballots, no central tallying authority",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.17"
  }
}
